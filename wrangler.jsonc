{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brownie-shop",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brownie-shop-db",
      "database_id": "f5916bbd-b7d3-492d-b8a5-38ba8de66d43"
    }
  ]
}
